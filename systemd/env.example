# Copy to ~/.config/github-agent-bridge/env and chmod 600.
# Start with shadow mode. Switch to live only after replay/shadow validation.
GITHUB_AGENT_BRIDGE_MODE=shadow
GITHUB_AGENT_BRIDGE_WORKERS=4
GITHUB_AGENT_BRIDGE_REVIEW_TIMEOUT=900
GITHUB_AGENT_BRIDGE_WORK_TIMEOUT=7200
GITHUB_AGENT_BRIDGE_REVIEW_RUNNING_WARN_SECONDS=600
GITHUB_AGENT_BRIDGE_WORK_RUNNING_WARN_SECONDS=900
GITHUB_AGENT_BRIDGE_PROGRESS_WARN_SECONDS=600
GITHUB_AGENT_BRIDGE_AUTO_UNLOCK_STALE_SECONDS=900
# Optional: after a stalled-job alert, sample executor child process activity and
# terminate stale child process groups before retrying the affected job ids.
GITHUB_AGENT_BRIDGE_KILL_STALE_CHILDREN=
GITHUB_AGENT_BRIDGE_PROC_IDLE_SECONDS=240
GITHUB_AGENT_BRIDGE_TERMINATE_GRACE_SECONDS=5
GITHUB_AGENT_BRIDGE_ALERT_RESEND_SECONDS=900
GITHUB_AGENT_BRIDGE_PROCESS_SAMPLE_RETENTION_SECONDS=86400
# Optional: check the latest published GitHub release so gab monitor alerts when
# the active service venv lags behind the current release.
GITHUB_AGENT_BRIDGE_RELEASE_REPO=pilipilisbot/github-agent-bridge
GITHUB_AGENT_BRIDGE_AUTOUPDATE_REPO=pilipilisbot/github-agent-bridge
GITHUB_AGENT_BRIDGE_AUTOUPDATE_REPO_DIR=
GITHUB_AGENT_BRIDGE_AUTOUPDATE_INSTALL_COMMAND=
GITHUB_AGENT_BRIDGE_AUTOUPDATE_BACKUP_DIR=
GITHUB_AGENT_BRIDGE_SYSTEMCTL_BIN=systemctl
GITHUB_AGENT_BRIDGE_JOURNALCTL_BIN=journalctl
GITHUB_AGENT_BRIDGE_EXECUTOR_UNIT=github-agent-bridge.service
GITHUB_AGENT_BRIDGE_DASHBOARD_UNIT=github-agent-bridge-dashboard.service
GITHUB_AGENT_BRIDGE_READER_SERVICE_UNIT=github-agent-bridge-reader.service
GITHUB_AGENT_BRIDGE_READER_TIMER_UNIT=github-agent-bridge-reader.timer
GITHUB_AGENT_BRIDGE_MONITOR_SERVICE_UNIT=github-agent-bridge-monitor.service
GITHUB_AGENT_BRIDGE_MONITOR_TIMER_UNIT=github-agent-bridge-monitor.timer
GITHUB_AGENT_BRIDGE_FEEDBACK_SERVICE_UNIT=github-agent-bridge-feedback.service
GITHUB_AGENT_BRIDGE_FEEDBACK_TIMER_UNIT=github-agent-bridge-feedback.timer
GITHUB_AGENT_BRIDGE_AUTOUPDATE_SERVICE_UNIT=github-agent-bridge-autoupdate.service
GITHUB_AGENT_BRIDGE_AUTOUPDATE_TIMER_UNIT=github-agent-bridge-autoupdate.timer
GITHUB_AGENT_BRIDGE_OPENCLAW_BIN=openclaw
GITHUB_AGENT_BRIDGE_NODE_BIN=
GITHUB_AGENT_BRIDGE_FEEDBACK_MODEL=
GITHUB_AGENT_BRIDGE_DEFAULT_CHANNEL=telegram
GITHUB_AGENT_BRIDGE_DEFAULT_TO=

# Optional Sentry error reporting. Install github-agent-bridge[sentry] in the
# service venv before setting a DSN.
GITHUB_AGENT_BRIDGE_SENTRY_DSN=
GITHUB_AGENT_BRIDGE_SENTRY_ENVIRONMENT=
GITHUB_AGENT_BRIDGE_SENTRY_RELEASE=
GITHUB_AGENT_BRIDGE_SENTRY_TRACES_SAMPLE_RATE=
GITHUB_AGENT_BRIDGE_SENTRY_PROFILES_SAMPLE_RATE=

# IMAP reader settings.
GITHUB_AGENT_BRIDGE_EMAIL=you@example.com
GITHUB_AGENT_BRIDGE_PASSWORD=imap-app-password
GITHUB_AGENT_BRIDGE_IMAP_HOST=imap.gmail.com
GITHUB_AGENT_BRIDGE_IMAP_PORT=993
# IMAP folder/mailbox to scan. For shared accounts this can be a dedicated
# folder such as GitHub or "[Gmail]/All Mail".
GITHUB_AGENT_BRIDGE_MAILBOX=INBOX
# Leave empty for shadow reads; set to --mark-seen only when this bridge owns GitHub notifications.
GITHUB_AGENT_BRIDGE_MARK_SEEN=

# Optional dashboard API / UI settings.
# Create a GitHub OAuth App with callback URL:
# http://127.0.0.1:8765/auth/callback
GITHUB_AGENT_BRIDGE_DASHBOARD_SECRET_KEY=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_AGENT_BRIDGE_DASHBOARD_ALLOWED_USERS=
GITHUB_AGENT_BRIDGE_DASHBOARD_ALLOWED_ORGS=
GITHUB_AGENT_BRIDGE_DASHBOARD_ALLOWED_TEAMS=
GITHUB_AGENT_BRIDGE_DASHBOARD_ADMIN_USERS=
GITHUB_AGENT_BRIDGE_DASHBOARD_ADMIN_TEAMS=
GITHUB_AGENT_BRIDGE_DASHBOARD_PUBLIC_URL=
# Optional browser Push API notifications for completed bridge jobs. The public
# key is served to signed-in dashboard users; keep the private key secret.
GITHUB_AGENT_BRIDGE_WEB_PUSH_VAPID_PUBLIC_KEY=
GITHUB_AGENT_BRIDGE_WEB_PUSH_VAPID_PRIVATE_KEY=
GITHUB_AGENT_BRIDGE_WEB_PUSH_VAPID_CONTACT=mailto:admin@example.com
